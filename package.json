{
  "name": "shipflow",
  "version": "0.3.1",
  "description": "Unified Shipping SDK for MENA Region — Aymakan, SMSA Express, Aramex, and more",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./carriers/aymakan": {
      "types": "./dist/carriers/aymakan/index.d.ts",
      "import": "./dist/carriers/aymakan/index.js"
    },
    "./carriers/smsaexpress": {
      "types": "./dist/carriers/smsaexpress/index.d.ts",
      "import": "./dist/carriers/smsaexpress/index.js"
    },
    "./carriers/aramex": {
      "types": "./dist/carriers/aramex/index.d.ts",
      "import": "./dist/carriers/aramex/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build src/index.ts src/carriers/aymakan/index.ts src/carriers/smsaexpress/index.ts src/carriers/aramex/index.ts --outdir dist --splitting --target node --format esm --sourcemap=external && bun run build:fix-dts",
    "build:fix-dts": "find dist -name '*.d.ts' -exec sed -i -E \"s/from '(\\.\\.?\\/[^']+)'/from '\\1.js'/g; s/from \\\"(\\.\\.?\\/[^\\\"]+)\\\"/from \\\"\\1.js\\\"/g\" {} +",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.5 || ^6"
  },
  "keywords": [
    "shipping",
    "aymakan",
    "smsa",
    "smsaexpress",
    "aramex",
    "saudi-arabia",
    "mena",
    "logistics",
    "cod",
    "ecommerce",
    "tracking"
  ],
  "repository": {
    "url": "https://github.com/aashahin/shipflow"
  },
  "author": "Abdelrahman Shaheen",
  "license": "MIT"
}
